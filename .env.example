# Copy to .env for local runs. In Mastra Cloud, set these as environment variables.
ANTHROPIC_API_KEY=
# Optional: override the model, e.g. a Bedrock model once that provider is approved.
# MASTRA_MODEL=anthropic/claude-sonnet-5-5
# Optional: the per-run cost bound in USD (default 2).
# MASTRA_RUN_COST_BOUND_USD=2
# Optional: a hosted LibSQL (Turso) database, so chats, sessions and proposals
# survive deploys. Without it, each deploy starts from an empty local file.
# MASTRA_DB_URL=libsql://<your-db>.turso.io
# MASTRA_DB_AUTH_TOKEN=
